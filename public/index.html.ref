",null,{\"className\":\"font-semibold text-[32px] leading-[38px] tracking-[-1.28px] text-humble-beige md:text-[40px] md:leading-[46px] md:tracking-[-1.6px]\",\"children\":[[\"$\",\"span\",\"Blue Sky\",{\"className\":\"block\",\"children\":\"Blue Sky\"}],[\"$\",\"span\",\"S163\",{\"className\":\"block\",\"children\":\"S163\"}]]}]}],[\"$\",\"p\",null,{\"className\":\"font-normal text-[14px] leading-[20px] tracking-[-0.28px] text-white\",\"children\":\"6.x MW Platform\"}]]}],[\"$\",\"article\",null,{\"className\":\"flex min-w-0 w-full flex-col gap-8 min-[1000px]:max-w-none\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-6 text-white\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-normal text-[18px] leading-[28px] tracking-[-0.36px] md:text-[20px] md:tracking-[-0.4px]\",\"children\":\"The S163 adapts to moderate-to-high wind sites to deliver higher output while maintaining a lower levelised cost of energy. This platform is made for scale and high performance.\"}],[\"$\",\"div\",null,{\"className\":\"flex flex-col gap-4\",\"children\":[[\"$\",\"p\",null,{\"className\":\"font-semibold text-[24px] leading-[30px] tracking-[-0.96px] md:text-[30px] md:leading-[36px] md:tracking-[-1.2px]\",\"children\":\"Highlights:\"}],[\"$\",\"ul\",null,{\"className\":\"list-disc space-y-4 pl-[30px] marker:text-white\",\"children\":[[\"$\",\"li\",\"Available in up to 150m hub heights\",{\"className\":\"font-normal text-[18px] leading-[28px] tracking-[-0.36px] md:text-[20px] md:tracking-[-0.4px]\",\"children\":\"Available in up to 150m hub heights\"}],[\"$\",\"li\",\"Moderate to high winds\",{\"className\":\"font-normal text-[18px] leading-[28px] tracking-[-0.36px] md:text-[20px] md:tracking-[-0.4px]\",\"children\":\"Moderate to high winds\"}],[\"$\",\"li\",\"Modular for site-adaptability\",{\"className\":\"font-normal text-[18px] leading-[28px] tracking-[-0.36px] md:text-[20px] md:tracking-[-0.4px]\",\"children\":\"Modular for site-adaptability\"}]]}]]}]]}],\"$