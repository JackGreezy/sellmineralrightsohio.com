\",null,{}],[\"$\",\"main\",null,{\"children\":[[\"$\",\"div\",null,{\"className\":\"relative w-full\",\"children\":[[\"$\",\"section\",null,{\"className\":\"relative w-full overflow-hidden bg-humble-beige block leading-[0]\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid w-full grid-cols-1 grid-rows-1 h-[clamp(320px,177.8vw,761px)] md:h-[clamp(432px,56.25vw,1080px)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"col-span-full row-span-full relative min-h-0 h-full w-full overflow-hidden\",\"children\":[\"$\",\"picture\",null,{\"children\":\"$11\"}]}]}]}],[\"$\",\"div\",null,{\"className\":\"relative z-10 -mt-12 sm:-mt-20 lg:-mt-[100px] xl:-mt-[200px] min-[1440px]:-mt-[310px] w-full overflow-hidden rounded-tl-[16px] rounded-tr-[16px] bg-humble-beige\",\"children\":[\"$\",\"section\",null,{\"className\":\"pb-16 pt-10 md:pb-20 md:pt-16 lg:pb-[clamp(96px,10vw,160px)]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto w-full max-w-[1440px] px-4 sm:px-5 md:px-6 lg:px-10 min-[1440px]:px-[40px] flex flex-col gap-10 min-[1440px]:gap-14\",\"children\":[[\"$\",\"nav\",null,{\"aria-label\":\"Breadcrumb\",\"className\":\"flex flex-wrap items-center gap-x-2 gap-y-1 whitespace-normal sm:whitespace-nowrap font-medium text-[10px] leading-[12px] tracking-[-0.2px]\",\"children\":[[\"$\",\"$1\",\"0\",{\"children\":[false,[\"$\",\"$L12\",null,{\"href\":\"/\",\"className\":\"shrink-0 transition-colors duration-200 text-ever-teal-100 hover:text-ever-teal-80\",\"children\":\"Home\"}]]}],[\"$\",\"$1\",\"1\",{\"children\":[[\"$\",\"span\",null,{\"className\":\"shrink-0 text-dark-2/40\",\"aria-hidden\":true,\"children\":\"/\"}],[\"$\",\"$L12\",null,{\"href\":\"/our-businesses\",\"className\":\"shrink-0 transition-colors duration-200 text-dark-2 hover:text-dark-1\",\"children\":\"Our Businesses\"}]]}],[\"$\",\"$1\",\"2\",{\"children\":[[\"$\",\"span\",null,{\"className\":\"shrink-0 text-dark-2/40\",\"aria-hidden\":true,\"children\":\"/\"}],[\"$\",\"$L12\",null,{\"href\":\"/our-businesses/products\",\"className\":\"shrink-0 transition-colors duration-200 text-dark-2 hover:text-dark-1\",\"children\":\"Products\"}]]}],[\"$\",\"$1\",\"3\",{\"children\":[[\"$\",\"span\",null,{\"className\":\"shrink-0 text-dark-2/40\",\"aria-hidden\":true,\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-dark-2 min-w-0 truncate\",\"title\":\"Wind\",\"children\":\"Wind\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"flex max-w-[780px] flex-col gap-6\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"font-bold text-ever-teal-100 text-[42px] leading-[48px] tracking-[-2.4px] md:text-[56px] md:leading-[62px] md:tracking-[-3px] lg:text-[80px] lg:leading-[86px] lg:tracking-[-4.8px]\",\"children\":\"Built with intelligence from 10,000+ global wind turbines\"}],[\"$\",\"p\",null,{\"className\":\"font-normal text-dark-2 text-[18px] leading-[28px] tracking-[-0.36px] md:text-[20px] md:tracking-[-0.4px]\",\"children\":\"Make your site work with wind platforms designed around real-world conditions. Across terrains, wind regimes and operating realities, our turbines are made with three decades of R\u0026D and manufacturing expertise. Assured performance, always.\"}]]}],null]}]}]}]]}],[\"$\",\"$L13\",null,{\"data\":{\"backgroundImageSrc\":\"/assets-f/img/b36f384a6cd630.jpg\",\"backgroundVideoSrc\":\"/assets-f/media/4534cb6d9dbdf4.mp4\",\"backgroundImageAlt\":\"Wind turbine construction aerial view\",\"title\":\"Wind 2.0 – because the energy transition needs wind that’s smarter\",\"titleLines\":[\"Wind 2.0 – because the energy\",\"transition needs wind that’s smarter\"],\"lead\":\"Wind 2.0 moves wind energy beyond turbines. It connects advanced platforms, digital intelligence, hybrid systems, storage, and grid-smart controls into one ecosystem. Fewer, more efficient turbines that give you more output, better reliability. Built for firm, flexible, and predictable clean energy. This is the future of wind.\",\"size\":\"tall\",\"pillars\":[{\"title\":\"Terrain and wind diversity\",\"titleLines\":[\"Terrain and wind \",\"diversity\"],\"description\":\"Every site has different wind behaviour, terrain, logistics, and grid conditions. Platforms must perform for your operational realities.\"},{\"title\":\"Better Output\",\"description\":\"Turbines must deliver more, higher-quality energy to support uninterrupted operations in an ever-evolving energy world.\"},{\"title\":\"Lifecycle continuity\",\"description\":\"Turbines need to stay productive to offer you the best performance value for your operational goals and commercial priorities.\"}]}}],\"$L14\",\"$L15\",\"$L16\",\"$L17\",\"$L18\",\"$L19\",\"$L1a\"]}],\"$L1b\"]}]\n"])</script><script>self.__next_f.push([1,"14:[\"$\",\"$L1c\",null,{\"data\":{\"title\":\"Wind platforms designed for the next generation of energy\",\"titleLines\":[\"Wind platforms designed\",\"for the next generation of energy\"],\"lead\":\"We’ve spent decades advancing wind technology through continuous engineering, field learning, and innovation. Intelligent turbine platforms that perform across geographies and wind regimes. Backed by in-house R\u0026D and end-to-end manufacturing expertise. Ready to integrate into full-stack renewable energy ecosystems to give you dependable power.\",\"leadLines\":[\"We’ve spent decades advancing wind technology through continuous engineering, field learning, and innovation. \",\"The result? Intelligent turbine platforms that perform across geographies and wind regimes. Backed by in-house\",\"R\u0026D and end-to-end manufacturing expertise. Ready to integrate into full-stack renewable energy\",\"ecosystems to give you dependable power.\"],\"layout\":\"onshore-wind\",\"cards\":[{\"title\":\"Built for terrain and wind diversity\",\"description\":\"No two wind sites are the same. That’s why our platforms are defined by a deep understanding of varied wind regimes, terrain conditions, and project environments. Whether low, moderate or high wind speeds, we make it work for your operations.\",\"footnote\":\"Wind regime matching | IEC class fit | Site-specific selection | Terrain-adapted platforms\",\"imageSrc\":\"/assets-f/img/d96de24d47706d.jpg\",\"imageAlt\":\"Wind turbine against blue sky\"},{\"title\":\"Customised component by component\",\"description\":\"In-house R\u0026D and manufacturing make up the core of our nacelles, towers, blades, hubs, and electrical systems. Every component is engineered to support better yield, output, and product life.\",\"footnote\":\"Hybrid Lattice Tower | Advanced blade materials | In-house manufacturing | Good make\",\"imageSrc\":\"/assets-f/img/5216293fa40b19.jpg\",\"imageAlt\":\"Solar panels and wind turbines\"},{\"title\":\"Lifecycle continuity\",\"description\":\"Our tech’s reliability comes from wind intelligence gathered through decades of operating experience. Lifetime maintenance, predictive intelligence, SCADA monitoring, and multi-brand expertise ensure your wind assets perform consistently throughout their full lifecycle.\",\"footnote\":\"OMS support | Predictive intelligence | SCADA monitoring | Multi-brand expertise\",\"imageSrc\":\"/assets-f/img/b4059d0b193b69.jpg\",\"imageAlt\":\"Energy storage and solar installation\"}],\"stats\":[{\"value\":\"21,700+\",\"label\":\"MW good energies installed\",\"labelLines\":[\"MW good \",\"energies installed\"]},{\"value\":\"10,000+\",\"label\":\"Assets operating worldwide\",\"labelLines\":[\"Assets operating\",\"worldwide\"]},{\"value\":\"1,900+\",\"label\":\"Good relationships across sectors\",\"labelLines\":[\"Good relationships\",\"across sectors\"]},{\"value\":\"20+\",\"label\":\"Years product lifecycle\",\"labelLines\":[\"Years product\",\"lifecycle\"]},{\"value\":\"3\",\"label\":\"Decades wind expertise\",\"labelLines\":[\"Decades\",\"wind expertise\"]}]}}]\n"])</script><script>self.__next_f.push([1,"15:[\"$\",\"section\",null,{\"id\":\"platforms\",\"children\":[\"$\",\"section\",null,{\"id\":\"systems\",\"className\":\"bg-ever-teal-100 py-16 m