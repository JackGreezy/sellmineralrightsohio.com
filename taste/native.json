    "related": "<section class=\"relative w-full overflow-hidden bg-ever-teal-100 max-w-full\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-5 md:px-6 lg:px-10 min-[1440px]:px-[40px] pt-10 pb-16 md:pt-16 md:pb-20\"><div class=\"flex w-full flex-col gap-10 lg:gap-14\"><p class=\"font-semibold text-white text-[28px] leading-[34px] tracking-[-1.12px] md:text-[36px] md:leading-[42px] md:tracking-[-1.44px]\">{heading}</p><div class=\"grid w-full min-w-0 grid-cols-1 gap-6 sm:grid-cols-2 lg:gap-6 xl:gap-8\">{items}</div><div><a class=\"group/viewall flex gap-[2px] items-center relative shrink-0 w-fit\" href=\"{all_href}\"><div class=\"flex items-center justify-center p-3 sm:p-[16px] rounded-[4px] shrink-0 transition-all duration-300 border border-ever-teal-100 bg-ever-teal-80 text-white group-hover/viewall:bg-ever-teal-100\"><span class=\"font-semibold leading-[16px] text-[12px] sm:text-[14px] tracking-[0.28px] whitespace-nowrap\">{all_label}</span></div><div class=\"relative size-[40px] shrink-0 overflow-hidden sm:size-[48px]\"><div class=\"pointer-events-none absolute inset-0 flex items-center justify-center\"><svg aria-hidden=\"true\" class=\"block size-[24px] shrink-0\" fill=\"none\" viewBox=\"0 0 20 20\"><path class=\"fill-bold-amber\" d=\"M8.63 9.53H0.47L0 10L0.47 10.47H8.63L9.1 10L8.63 9.53Z\"></path><path class=\"fill-ever-teal-100\" d=\"M19.53 9.53H11.37L10.9 10L11.37 10.47H19.53L20 10L19.53 9.53Z\"></path><path class=\"fill-ever-teal-100\" d=\"M10.47 8.63V0.47L10 0L9.53003 0.47V8.63L10 9.1L10.47 8.63Z\"></path><path class=\"fill-bold-amber\" d=\"M10.47 19.53V11.37L10 10.9L9.53003 11.37V19.53L10 20L10.47 19.53Z\"></path></svg></div></div></a></div></div></div></section>",
    "related_item": "<a class=\"flex h-full min-w-0 flex-col gap-6 rounded-[16px] bg-white p-6 md:p-8\" href=\"{href}\"><h3 class=\"whitespace-pre-line font-semibold text-ever-teal-100 text-[24px] leading-[30px] tracking-[-0.96px] md:text-[30px] md:leading-[36px] md:tracking-[-1.2px]\">{name}</h3><p class=\"font-normal text-dark-2 text-[16px] leading-[24px] tracking-[-0.32px]\">{teaser}</p></a>",
    "cta": "<section class=\"rounded-t-[16px] bg-humble-beige pt-10 pb-16 md:pt-16 md:pb-20 min-[1440px]:pb-[160px]\"><div class=\"mx-auto w-full max-w-[1440px] px-4 sm:px-5 md:px-6 lg:px-10\"><div class=\"flex w-full flex-col items-center gap-6 text-center\"><p class=\"font-semibold text-ever-teal-100 text-[28px] leading-[34px] tracking-[-1.12px] md:text-[36px] md:leading-[42px] md:tracking-[-1.44px] min-[1440px]:text-[40px] min-[1440px]:leading-[46px] min-[1440px]:tracking-[-1.6px]\">{title}</p><p class=\"font-normal text-dark-2 text-[17px] leading-[26px] tracking-[-0.34px]\">{intro}</p><div class=\"flex flex-wrap items-center justify-center gap-6\"><a class=\"group/viewall flex gap-[2px] items-center relative shrink-0 w-fit\" href=\"{contact_href}\"><div class=\"flex items-center justify-center p-3 sm:p-[16px] rounded-[4px] shrink-0 transition-all duration-300 border border-ever-teal-100 bg-ever-teal-80 text-white group-hover/viewall:bg-ever-teal-100\"><span class=\"font-semibold leading-[16px] text-[12px] sm:text-[14px] tracking-[0.28px] whitespace-nowrap\">{label}</span></div><div class=\"relative size-[40px] shrink-0 overflow-hidden sm:size-[48px]\"><div class=\"pointer-events-none absolute inset-0 flex items-center justify-center\"><svg aria-hidden=\"true\" class=\"block size-[24px] shrink-0\" fill=\"none\" viewBox=\"0 0 20 20\"><path class=\"fill-bold-amber\" d=\"M8.63 9.53H0.47L0 10L0.47 10.47H8.63L9.1 10L8.63 9.53Z\"></path><path class=\"fill-ever-teal-100\" d=\"M19.53 9.53H11.37L10.9 10L11.37 10.47H19.53L20 10L19.53 9.53Z\"></path><path class=\"fill-ever-teal-100\" d=\"M10.47 8.63V0.47L10 0L9.53003 0.47V8.63L10 9.1L10.47 8.63Z\"></path><path class=\"fill-bold-amber\" d=\"M10.47 19.53V11.37L10 10.9L9.53003 11.37V19.53L10 20L10.47 19.53Z\"></path></svg></div></div></a><a class=\"font-semibold text-ever-teal-100\" href=\"{tel_href}\">Call {phone}</a></div></div></div></section>"
